{
  "name": "devvault",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand --config jest.config.js",
    "prebuild": "expo prebuild",
    "audit": "npm audit --omit=dev",
    "validate:schema": "python tools/validate_schema.py",
    "audit:full": "npm audit",
    "build:android": "npx expo prebuild --platform android && npx expo run:android",
    "build:ios": "npx expo prebuild --platform ios && npx expo run:ios",
    "security:source": "python tools/check_secrets.py && python tools/validate_schema.py",
    "test:ci": "npm run typecheck && npm test && npm run lint && npm run security:source"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.0",
    "expo-local-authentication": "~17.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-sqlite": "~16.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^2.0.0",
    "expo-crypto": "~15.0.9",
    "expo-screen-capture": "~8.0.10",
    "expo-font": "~14.0.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.38.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.13",
    "typescript": "~5.9.2",
    "@typescript-eslint/parser": "^8.46.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "babel-preset-expo": "~54.0.5"
  }
}
